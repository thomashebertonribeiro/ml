# =============================================================================
# ML Category Web — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running the application.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=mlcategory
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mlcategory

# Full async DSN — constructed automatically by docker-compose from the vars above.
# Override here only if you are connecting to an external database.
# DATABASE_URL=postgresql+asyncpg://mlcategory:change_me_strong_password@db:5432/mlcategory

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string_generated_by_secrets_module

# JWT expiry in seconds (default: 86400 = 24 hours)
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# One of: development | staging | production
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Maximum requests per minute per IP for the public API
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Mercado Livre API
# -----------------------------------------------------------------------------
ML_API_BASE_URL=https://api.mercadolibre.com

# Delay in seconds between consecutive ML API requests (avoid rate limiting)
ML_REQUEST_DELAY_SECONDS=0.3

# Maximum retry attempts for ML API requests
ML_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Nginx / SSL (production only)
# -----------------------------------------------------------------------------
# Your domain name — used by Nginx and Certbot
DOMAIN=example.com

# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@example.com
